# Sovereign Creative Studio — backend configuration.
# Copy to .env and fill in machine-specific values (paths, etc.).
# See docs/MODEL_AND_DEPENDENCY_MANIFEST.md for setup instructions.

# --- Database & storage ------------------------------------------------------
# DATABASE_URL=sqlite:///./sovereign.db
# STORAGE_DIR=./storage
# EXPORT_DIR=./storage/exports

# --- CORS --------------------------------------------------------------------
# FRONTEND_ORIGIN=http://localhost:3000

# --- Image / product-scene generators ----------------------------------------
# GENERATOR_BACKEND=mock                # mock | comfyui
# PRODUCT_SCENE_BACKEND=mock            # mock | comfyui
# PRODUCT_SCENE_MODEL=                  # flux-kontext | qwen-image | hidream-e1
# COMFYUI_BASE_URL=http://127.0.0.1:8001
# COMFYUI_WORKFLOW_PATH=workflows/text_to_image.json
# COMFYUI_PRODUCT_SCENE_MODE=img2img    # img2img | ipadapter | inpaint
# COMFYUI_PRODUCT_SCENE_INPAINT_FALLBACK=img2img   # img2img | ipadapter

# --- Video generator ---------------------------------------------------------
# VIDEO_BACKEND=mock                  # mock | comfyui
# COMFYUI_VIDEO_WORKFLOW_PATH=workflows/image_to_video.json
# COMFYUI_VIDEO_MODEL_NAME=ltx-2.3-22b-dev-fp8.safetensors

# --- Transcription -----------------------------------------------------------
# TRANSCRIPTION_BACKEND=local_whisper   # local_whisper | mock
# TRANSCRIPTION_MODEL_NAME=base         # base | small | medium | large-v2
# TRANSCRIPTION_DEVICE=cpu             # cpu | cuda
# TRANSCRIPTION_COMPUTE_TYPE=int8      # int8 | float16

# --- FFmpeg (required for voice narration) -----------------------------------
# Set to the absolute path of ffmpeg.exe on this machine.
# Windows example: FFMPEG_PATH=C:\path\to\ffmpeg.exe
# Install from https://ffmpeg.org/ or: winget install Gyan.FFmpeg
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# --- Avatar / voice ----------------------------------------------------------
# VOICE_ENABLED=true
# VOICE_BACKEND=piper                 # mock | piper
# VOICE_MODEL_NAME=en_US-lessac-low  # default voice
# VOICE_MODEL_PATH=storage/models/piper/en_US-lessac-low.onnx
# Place .onnx and .onnx.json files in backend/storage/models/piper/
# Download from: https://huggingface.co/rhasspy/piper-voices
# AVATAR_ENABLED=true
# AVATAR_BACKEND=placeholder          # placeholder | comfyui_wan_infinite_talk
# AVATAR_WAN_WORKFLOW_PATH=workflows/avatar_wan_infinite_talk.json
# AVATAR_WAN_MODEL_NAME=
# AVATAR_INFINITETALK_PATCH_NAME=
# AVATAR_AUDIO_ENCODER_NAME=
# AVATAR_WAN_PRESET=tiny_test         # tiny_test | low_vram | balanced | quality | portrait_480p
# AVATAR_WAN_LORA_NAME=lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors  # optional step-distill LoRA (models/loras)
# AVATAR_WAN_WIDTH=                   # optional server-only override
# AVATAR_WAN_HEIGHT=                  # optional server-only override
# AVATAR_WAN_FRAMES=                  # optional server-only override
# AVATAR_WAN_STEPS=                   # optional server-only override
# AVATAR_WAN_CFG=                     # optional server-only override; keep 1.0 unless validated
# AVATAR_WAN_MAX_RETRIES=0            # keep 0 to avoid repeated OOM pressure

# --- Copy generator ----------------------------------------------------------
# COPY_BACKEND=mock   # mock | openai | claude | gemini | ollama | local-qwen | local-deepseek
# OPENAI_API_KEY=                       # required when COPY_BACKEND=openai
# OPENAI_COPY_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=                    # required when COPY_BACKEND=claude
# ANTHROPIC_COPY_MODEL=claude-3-5-sonnet-latest
# GEMINI_API_KEY=                       # required when COPY_BACKEND=gemini
# GEMINI_COPY_MODEL=gemini-1.5-flash
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_COPY_MODEL=llama3.1
# OLLAMA_QWEN_MODEL=qwen3:4b            # used by the local-qwen provider (summary AI)
# OLLAMA_DEEPSEEK_MODEL=qwen3.6:35b     # optional local reasoning fallback

# --- Credits -----------------------------------------------------------------
# DEFAULT_CREDITS=100
# CREDITS_PER_GENERATION=5
