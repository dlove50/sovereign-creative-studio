      "device": "default"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "__PROMPT__, camera motion preset: __MOTION_PRESET__, target duration: __DURATION_SECONDS__ seconds, cinematic product video, premium lighting, smooth motion"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
