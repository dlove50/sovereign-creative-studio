{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-cloud-dev/types/**/*.ts",
    ".next-release/types/**/*.ts",
    ".next-release-recovery/types/**/*.ts",
    ".next-video-repair/types/**/*.ts",
    ".next-video-live/types/**/*.ts",
    ".next-model-live/types/**/*.ts",
    ".next-provider-labels/types/**/*.ts",
    ".next-cinematic-planner/types/**/*.ts",
    ".next-cinematic-persistence/types/**/*.ts",
    ".next-cinematic-fixed/types/**/*.ts",
    ".next-cinematic-production/types/**/*.ts",
    ".next-training/types/**/*.ts",
    ".next-heygen-parity/types/**/*.ts",
    ".next-brand-import/types/**/*.ts",
    ".next-music-test/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
